# Application
APP_NAME=AuthForge
PORT=3000
NODE_ENV=development

# CORS - comma separated list of allowed origins, or * for any
CORS_ORIGINS=*

# Base URL of the frontend that consumes this API — used to build links
# embedded in emails (e.g. the password reset link). Not the API's own URL.
FRONTEND_URL=http://localhost:5173

# Database — same names the official postgres image and docker-compose.yml expect
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=authforge
POSTGRES_PASSWORD=authforge
POSTGRES_DB=authforge

# Redis - reserved for future distributed rate-limiting / cache storage
REDIS_URL=redis://localhost:6379

# JWT (HS256 by default). To switch to RS256 in the future, set JWT_PUBLIC_KEY
# and JWT_PRIVATE_KEY (base64 or PEM with \n escaped) instead of JWT_SECRET.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=15m
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=

# Refresh token
REFRESH_SECRET=change-me-to-a-different-long-random-string
REFRESH_EXPIRES=7d

# Security
LOGIN_THROTTLE_LIMIT=5
LOGIN_THROTTLE_TTL=60
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# RabbitMQ — used only to publish password-reset/forgot-password emails to
# MailForge's mail.queue (MailForge owns the topology, AuthForge only
# publishes). Outside Docker: localhost:5672. Inside the Docker network, the
# root compose overrides this to amqp://guest:guest@rabbitmq:5672.
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Optional — used only by `npm run seed` to bootstrap the first ADMIN user
ADMIN_EMAIL=
ADMIN_PASSWORD=
